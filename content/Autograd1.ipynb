   "outputs": [],
   "source": [
    "import torch"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "fb51c64a-e8dc-4737-92ca-d43b96e44b99",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = torch.tensor(torch.pi/2, requires_grad=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "d4ac607a-e973-4898-9a36-69aef9419e82",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "tensor(1.5708, requires_grad=True)\n"
     ]
    }
   ],
   "source": [
    "print(x)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f446e00f-cf62-4207-92f5-cfe5f39598e6",
   "metadata": {},
   "source": [
    "#### Take function $f(x) = sin(x) + x^2$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "eb746060-9086-4462-af3c-d706a5d2a7f3",
   "metadata": {},
   "outputs": [],
   "source": [
    "f = torch.sin(x) + x**2"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6696dc13-5d53-461b-8735-5d81f5e196be",
   "metadata": {},
   "source": [
    "#### Take f's gradient in backpropagation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "0ddb69d4-170c-45ba-8250-4994c94641f3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "tensor(3.1416)\n"
     ]
    }
   ],
   "source": [
    "f.backward()\n",
    "print(x.grad)"
   ]
  },
